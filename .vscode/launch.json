{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 9876,
      "url": "http://localhost:4200",
      "sourceMaps": true,
      "timeout": 10000,
      "postDebugTask": "Debug",
      "outFiles": [
        "${workspaceFolderBasename}/dist/renderer/**/*.js"
      ]
    },
    {
      "name": "Main",
      "type": "node",
      "request": "launch",
      //"protocol": "inspector",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "program": "${workspaceFolder}/projects/main/src/main.ts",
      "runtimeArgs": [
        "--serve",
        ".",
        "--remote-debugging-port=9876",
        "--trace-warnings",
        "--experimental-network-inspection",
        "--experimental-inspector-network-resource",
        //"--user-data-dir=remote-debug-profile"
      ],
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "preLaunchTask": "Build",
      "postDebugTask": "terminate: serve:renderer",
      "outFiles": [
        "${workspaceFolder}/dist/main/**/*.js"
      ],
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Application Debug",
      "configurations": [
        "Main",
        "Renderer"
      ],
      //"stopAll": true
    }
  ]
}