{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "module": "node16",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    //"baseUrl": ".",
    "rootDir": "./src",
    "outDir": "../../dist/preload",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "paths": {
      "*": [
        "./node_modules/*"
      ]
    }
  },
  "files": [
    "src/index.ts"
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
  ]
}