{
  "compilerOptions": {
    "target": "ES6",
    "allowJs": true,
    "module": "node16",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    // "baseUrl": ".",
    "rootDir": "./src",
    "outDir": "../../dist/main",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "paths": {
      "*": [
        "./node_modules/*"
      ]
    },
    "inlineSources": true,
    // Set `sourceRoot` to  "/" to strip the build path prefix
    // from generated source code references.
    // This improves issue grouping in Sentry.
    //"sourceRoot": "/" -- NOTE: This breaks breakpoints in VSCode. It will be disabled for now as by default it is "" which should not break issue grouping
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
  ]
}